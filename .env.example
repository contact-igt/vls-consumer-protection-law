# Copy this file to .env.local and fill in real values before deploying.
# Never commit .env.local — it is already covered by .gitignore.

# ---------------------------------------------------------------------------
# Lead API (server-only — read by app/api/lead/route.ts)
# ---------------------------------------------------------------------------
# Endpoint the site's own /api/lead route forwards validated registrations to
# (e.g. a CRM webhook, Google Sheets integration, or internal lead service).
# Leave empty during development — leads will simply be logged server-side.
LEAD_API_ENDPOINT=

# Bearer token sent as `Authorization: Bearer <key>` to LEAD_API_ENDPOINT.
# Server-only. Never prefix this with NEXT_PUBLIC_.
LEAD_API_KEY=

# ---------------------------------------------------------------------------
# Payment
# ---------------------------------------------------------------------------
# NOTE: the live payment link is stored in data/masterclass.ts (paymentUrl)
# rather than here, so it stays alongside the rest of the editable masterclass
# content. This variable is provided in case a deployment prefers to inject
# it as a build-time env var instead — wire it into data/masterclass.ts if so.
NEXT_PUBLIC_PAYMENT_URL=

# ---------------------------------------------------------------------------
# Analytics (public — safe to expose to the browser)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ---------------------------------------------------------------------------
# WhatsApp
# ---------------------------------------------------------------------------
# NOTE: the WhatsApp number is stored in data/masterclass.ts (whatsappNumber)
# for the same reason as the payment URL. Kept here for deployments that
# prefer environment-based configuration.
NEXT_PUBLIC_WHATSAPP_NUMBER=
